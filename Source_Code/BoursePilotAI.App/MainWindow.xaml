<Window x:Class="BoursePilotAI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:BoursePilotAI"
 Title="BoursePilotAI" Height="650" Width="1100">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="220"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#202020">
   <StackPanel>
    <TextBlock Text="BoursePilotAI" Foreground="White" FontSize="24" Margin="20"/>
    <Button Content="🏠 داشبورد" Margin="10" Height="40"/>
    <Button Content="📈 تحلیل سهام" Margin="10" Height="40"/>
    <Button Content="🔍 جستجوی نماد" Margin="10" Height="40"/>
    <Button Content="📄 گزارش‌ها" Margin="10" Height="40"/>
    <Button Content="⚙ تنظیمات" Margin="10" Height="40"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Column="1" Margin="25">
   <StackPanel>
    <TextBlock Text="داشبورد بازار" FontSize="32"/>
    <TextBlock Text="نمای کلی وضعیت بورس و تحلیل هوشمند" FontSize="18" Margin="0,10,0,20"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" BorderThickness="1" Padding="20" Margin="5"><StackPanel><TextBlock Text="شاخص کل"/><TextBlock Text="2,150,000" FontSize="26"/></StackPanel></Border>
     <Border Grid.Column="1" BorderThickness="1" Padding="20" Margin="5"><StackPanel><TextBlock Text="وضعیت بازار"/><TextBlock Text="مثبت" FontSize="26"/></StackPanel></Border>
     <Border Grid.Column="2" BorderThickness="1" Padding="20" Margin="5"><StackPanel><TextBlock Text="سیگنال AI"/><TextBlock Text="آماده تحلیل" FontSize="26"/></StackPanel></Border>
    </Grid>
    <TextBlock Text="نمادهای منتخب" FontSize="24" Margin="5,25,5,10"/>
    <DataGrid AutoGenerateColumns="True" Height="200" Margin="5">
     <DataGrid.Items>
      <local:StockItem Symbol="فولاد" Price="5200" Change="+2%" Status="خرید"/>
      <local:StockItem Symbol="شستا" Price="1450" Change="-1%" Status="نگهداری"/>
      <local:StockItem Symbol="خودرو" Price="320" Change="+0.5%" Status="بررسی"/>
     </DataGrid.Items>
    </DataGrid>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>