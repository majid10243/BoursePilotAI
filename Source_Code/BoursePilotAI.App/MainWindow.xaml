<Window x:Class="BoursePilotAI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BoursePilotAI" Height="600" Width="1000">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="220"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border Grid.Column="0" Background="#202020">
   <StackPanel>
    <TextBlock Text="BoursePilotAI" Foreground="White" FontSize="24" Margin="20"/>
    <Button Content="🏠 داشبورد" Margin="10" Height="40"/>
    <Button Content="📈 تحلیل سهام" Margin="10" Height="40"/>
    <Button Content="🔍 جستجوی نماد" Margin="10" Height="40"/>
    <Button Content="📄 گزارش‌ها" Margin="10" Height="40"/>
    <Button Content="⚙ تنظیمات" Margin="10" Height="40"/>
   </StackPanel>
  </Border>

  <Grid Grid.Column="1" Margin="25">
   <StackPanel>
    <TextBlock Text="داشبورد بازار" FontSize="32"/>
    <TextBlock Text="وضعیت بازار و تحلیل‌های هوشمند" FontSize="18" Margin="0,10,0,30"/>
    <Border BorderThickness="1" Padding="20">
     <TextBlock Text="آماده دریافت داده‌های بورس" FontSize="20"/>
    </Border>
   </StackPanel>
  </Grid>
 </Grid>
</Window>