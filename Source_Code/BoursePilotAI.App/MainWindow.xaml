<Window x:Class="BoursePilotAI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BoursePilotAI" Height="650" Width="1100">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="220"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border Grid.Column="0" Background="#202020">
   <StackPanel>
    <TextBlock Text="BoursePilotAI" Foreground="White" FontSize="24" Margin="20"/>
    <Button Content="🏠 داشبورد" Margin="10" Height="40"/>
    <Button Content="📈 تحلیل سهام" Margin="10" Height="40"/>
    <Button Content="🔍 جستجوی نماد" Margin="10" Height="40"/>
    <Button Content="📄 گزارش‌ها" Margin="10" Height="40"/>
    <Button Content="⚙ تنظیمات" Margin="10" Height="40"/>
   </StackPanel>
  </Border>

  <ScrollViewer Grid.Column="1" Margin="25">
   <StackPanel>
    <TextBlock Text="داشبورد بازار" FontSize="32"/>
    <TextBlock Text="نمای کلی وضعیت بورس و تحلیل هوشمند" FontSize="18" Margin="0,10,0,20"/>

    <DataGrid AutoGenerateColumns="False" Height="220" Margin="5">
     <DataGrid.Columns>
      <DataGridTextColumn Header="نماد" Binding="{Binding Symbol}"/>
      <DataGridTextColumn Header="قیمت" Binding="{Binding Price}"/>
      <DataGridTextColumn Header="تغییر" Binding="{Binding Change}"/>
      <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}"/>
     </DataGrid.Columns>
    </DataGrid>

    <Border BorderThickness="1" Padding="20" Margin="5,20,5,5">
     <StackPanel>
      <TextBlock Text="تحلیل هوشمند AI" FontSize="22"/>
      <TextBlock Text="آماده دریافت و تحلیل داده‌های بازار" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>